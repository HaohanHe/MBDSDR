#!/usr/bin/env python
"""pre-commit 机械闸：①跨线范围检查 ②逐个文件查 claim 台账 ③明文凭据扫描
④协调台账 §6.1 登记检查。

① `scripts/check_commit_scope.py --staged`：暂存区涉及 ≥2 个仍在 TTL 内的
   claim owner 时拒绝。
② `scripts/claim_gate.py --staged`：**逐文件**查台账——某文件仍被别的 owner
   持有、未过期、且没有有效 takeover 时拒绝（同一 owner 提交自己持有的文件放行；
   台账读不到/格式不认识/pid 存活判不了一律拒）。② 是 ① 的补丁：① 只拦
   「一次提交里出现 ≥2 个 owner」，单文件夹带别人的 claim 时 ① 看不见。
   提交者身份用 `MBDSDR_CLAIM_OWNER`（或 `git config mbdsdr.owner`）声明，
   必须与台账 owner 原文一致。
③ `scripts/secret_scan.py --staged`：扫**暂存区内容**（不是工作树）的明文凭据
   形状；命中只打印「文件:行 + 规则名」，不打印值。测试夹具/文档占位需在命中行
   加 `# pragma: allowlist secret` 逐行豁免，不支持目录级豁免。
④ `scripts/check_claim_coordination.py --staged`：暂存文件里仍有活跃 claim 的，
   必须在 `docs/COORDINATION.md` §6.1 已有行（逐条，或对只读批量目录的目录级行）。
   这条以前只能事后扫全量，等发现时已经提交了。**最近 60 分钟内被同一 owner
   持有过又释放的暂存文件同样要行**——否则「先 release 再提交」能在提交前一刻
   把行要求一起释放掉。预算 `COORD_BUDGET_S`：超过只告警不阻塞（说明原因），
   因为它是登记一致性检查，不是安全闸；读不到台账也降级为告警——「文件是否被
   他人占用」由 ② 的 claim_gate fail-closed 保底。

安装：python scripts/install_git_hooks.py
绕过：git commit --no-verify（会由 post-commit 写入 bypass 日志）
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

MANAGED = "MBDSDR-MANAGED-HOOK pre-commit"
#: ④ 的耗时预算（秒）：实测 0.22–0.30s；超预算只告警，不阻塞提交。
COORD_BUDGET_S = 0.30


def _git(*args):
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, encoding="utf-8", errors="replace"
    )


def _root():
    proc = _git("rev-parse", "--show-toplevel")
    return Path(proc.stdout.strip()) if proc.returncode == 0 else Path.cwd()


def main():
    root = _root()
    scope = Path(os.environ.get("MBDSDR_SCOPE_SCRIPT") or root / "scripts" / "check_commit_scope.py")
    staged = _git("diff", "--cached", "--name-only", "--no-renames")
    names = [line for line in staged.stdout.splitlines() if line.strip()]
    print(f"[pre-commit] 暂存文件 {len(names)} 个：")
    for name in names:
        print(f"  {name}")

    if not names:
        # 标记以 tree 命名：空暂存也写标记时，会覆盖同名 tree 的正常标记，
        # 让一笔真提交被消费方误判为「已审计」（2026-11-12，98d95982 实例）。
        print("[pre-commit] 暂存内容为空，不写闸门标记。")
        return 0

    if not scope.exists():
        print(f"[pre-commit] 拒绝：找不到 {scope}，无法执行 claim 闸门。")
        return 1

    proc = subprocess.run([sys.executable, str(scope), "--staged"], cwd=str(root))
    if proc.returncode == 1:
        print("[pre-commit] 拒绝提交：暂存范围不合规（跨线持有、出现声明清单外的文件、")
        print("[pre-commit] 出现未声明为意图删除的删除条目（陈旧私有 index 的幻影删除），")
        print("[pre-commit] 或声明的私有 index 与实际读取的 index 不一致）。")
        print("[pre-commit] 见上方 MULTI / EXTRA / DELETE / DECLARED-ACTUAL：先剔除文件或改对 index。")
        print("[pre-commit] 真删文件：用 `--intent-delete <path>`（可重复）或环境变量")
        print("[pre-commit]   MBDSDR_INTENT_DELETIONS（换行 / ; 分隔）逐条声明；")
        print("[pre-commit]   用 `python scripts/safe_commit.py --files ...` 提交会自动导出，不用手写。")
        print("[pre-commit] 幻影删除：先 `git read-tree HEAD` 重建私有 index，再重新 add；")
        print("[pre-commit]   索引基于旧 HEAD 时，新提交的树 = 旧树 + 你的改动，别人新增的文件会被记成删除。")
        print("[pre-commit] 私有 index 每次都要基于当前 HEAD `git read-tree HEAD` 重建，不要复用旧文件。")
        print("[pre-commit] 私有 index 不要依赖 shell 变量，用 `GIT_INDEX_FILE=<path> git commit ...`。")
        print("[pre-commit] 确认无在途改动后，可用 git commit --no-verify 绕过（会留痕）。")
        return 1
    if proc.returncode != 0:
        print(f"[pre-commit] claim 检查失败，退出码 {proc.returncode}，按失败关闭。")
        return proc.returncode

    # claim 闸脚本解析顺序：显式 override → hooks 目录里的安装副本 → 本树 scripts/。
    # hooks 是 common-dir 共享的，旧工作树里没有 scripts/claim_gate.py，只有安装副本
    # 才能保证「每棵树都能跑」而不是每棵树都失败关闭。
    candidates = [os.environ.get("MBDSDR_CLAIM_GATE")]
    common = _git("rev-parse", "--git-common-dir").stdout.strip()
    common_dir = None
    if common:
        common_dir = Path(common)
        if not common_dir.is_absolute():
            common_dir = root / common_dir
        candidates.append(str(common_dir / "hooks" / "claim_gate.py"))
    candidates.append(str(root / "scripts" / "claim_gate.py"))
    gate = next((Path(c) for c in candidates if c and Path(c).exists()), None)
    if gate is None:
        print(
            "[pre-commit] 拒绝：找不到 claim 闸（试试 python scripts/install_git_hooks.py），"
            "按失败关闭。"
        )
        return 1
    sys.stdout.flush()
    proc = subprocess.run([sys.executable, str(gate), "--staged"], cwd=str(root))
    if proc.returncode != 0:
        print(
            f"[pre-commit] claim 闸拒绝/失败（退出码 {proc.returncode}），按失败关闭；"
            "台账读不到、格式不认识、pid 存活判不了一律拒。"
        )
        return proc.returncode

    # 凭据扫描：优先用安装副本，保证旧工作树（没有 scripts/secret_scan.py）也能跑。
    scanner_candidates = [
        os.environ.get("MBDSDR_SECRET_SCAN"),
        str(common_dir / "hooks" / "secret_scan.py") if common_dir else None,
        str(root / "scripts" / "secret_scan.py"),
    ]
    scanner = next(
        (Path(c) for c in scanner_candidates if c and Path(c).exists()), None
    )
    if scanner is None:
        print(
            "[pre-commit] 拒绝：找不到凭据扫描器（试试 python scripts/install_git_hooks.py），"
            "按失败关闭。"
        )
        return 1
    sys.stdout.flush()
    proc = subprocess.run([sys.executable, str(scanner), "--staged"], cwd=str(root))
    if proc.returncode != 0:
        print("[pre-commit] 拒绝提交：暂存内容命中凭据形状规则。")
        print("[pre-commit] 报告只有「文件:行 + 规则名」，不含命中的值。")
        print("[pre-commit] 确认是测试夹具/文档占位时，在**那一行**加 `# pragma: allowlist secret`；")
        print("[pre-commit] 不支持目录级/文件级豁免。真凭据请先轮换，不要只删字面量。")
        return proc.returncode

    # ④ 协调台账登记：暂存文件里的活跃 claim 必须已有 §6.1 行。
    #    顺序放在最后：前面三道是安全闸（fail-closed），这道是登记一致性（超预算/读不到降级告警）。
    coord = Path(
        os.environ.get("MBDSDR_CLAIM_COORD") or root / "scripts" / "check_claim_coordination.py"
    )
    if coord.exists():
        sys.stdout.flush()
        started = time.perf_counter()
        proc = subprocess.run([sys.executable, str(coord), "--staged"], cwd=str(root))
        elapsed = time.perf_counter() - started
        if proc.returncode == 3:
            if elapsed <= COORD_BUDGET_S:
                print(
                    f"[pre-commit] 拒绝提交：活跃 claim 在 docs/COORDINATION.md §6.1 缺行"
                    f"（见上，本步 {elapsed:.2f}s）。"
                )
                print("[pre-commit] 补「文件 | 线名 | 开始时间 | 预计提交 hash」后重试；")
                print("[pre-commit] 目录级行只对 docs/<子目录>/** 只读批量成立，")
                print("[pre-commit] 代码根与 docs 顶层共享文档必须逐条。")
                return 3
            print(
                f"[pre-commit] 警告：§6.1 缺行，但本步 {elapsed:.2f}s 超 "
                f"{COORD_BUDGET_S:.2f}s 预算，本次不阻塞（补上台账，下笔会再拦）。"
            )
        elif proc.returncode != 0:
            print(
                f"[pre-commit] 警告：协调台账检查退出 {proc.returncode}"
                "（读不到台账/文档），本步不阻塞；文件占用由 claim_gate fail-closed 保底。"
            )
    else:
        print("[pre-commit] 警告：找不到 check_claim_coordination.py，跳过 §6.1 登记检查。")

    tree = _git("write-tree")
    if tree.returncode != 0:
        print("[pre-commit] git write-tree 失败，无法登记闸门通过标记。")
        return 1
    marker_dir = Path(
        os.environ.get("MBDSDR_HOOK_MARKER_DIR") or r"D:\mbdsdr\.locks\hook_ok"
    )
    marker_dir.mkdir(parents=True, exist_ok=True)
    marker = marker_dir / f"{tree.stdout.strip()}.json"
    marker.write_text(
        json.dumps(
            {"at": time.time(), "files": names, "pid": os.getpid()},
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )
    print(f"[pre-commit] 通过，标记 {marker.name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
