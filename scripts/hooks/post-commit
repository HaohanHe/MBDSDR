#!/usr/bin/env python
"""post-commit：记录未经 pre-commit 闸门的提交，并区分「主动绕过 / 钩子故障 / 未审计」。

pre-commit 通过时会在 hook_ok/<tree>.json 留标记，本钩子消费标记。没有标记的
提交分三类落盘（**不再把两类完全不同的事揉成一句**）：

  explicit    主动绕过：环境变量 ``MBDSDR_BYPASS_REASON`` 非空（事由原文必须含
              「事由 / 要提交的文件 / 预期 owner」）。写入 git_hook_bypass.log，
              ``bypass_kind="explicit"``；若同设 ``MBDSDR_COMMIT_PATHS`` /
              ``MBDSDR_DECLARED_INDEX``，一并记录声明与实际提交的差集。
  hook_error  钩子侧故障：无该变量，且能证明闸门侧坏了（pre-commit 不存在 /
              不是本仓管理的钩子 / 标记目录不可写）。写入 git_hook_bypass.log，
              ``bypass_kind="hook_error"`` 并附 ``hook_evidence``。
  unattributed 未审计：无该变量、也无故障证据（典型 = `git commit --no-verify`
              静默绕过，或 `--only`/私有 index 使 marker 树失配）。写入独立
              ``unaudited_commits.log``，``bypass_kind="unattributed"``、``audited=false``。

日志记录附带当时的 claim 台账快照（owner + 文件 + 是否活跃），
用于事后判断「绕过时到底有没有夹带别人」。

限制（明说）：pre-commit 被杀/未安装时提交也会被中止，故「无 marker 且钩子存在」
无法机械区分「--no-verify」与「--only 导致的树失配」——这两种一律进未审计日志，
不假装能分辨。

另做一道提交后自检（只补漏带，不改变提交结果）：对本次提交涉及的
每个路径跑 `git status --porcelain` / `git diff HEAD`；若工作区仍有
改动，说明这次提交吃进的是旧索引内容（如 14a6dc7 漏掉自己 11:47 的
编辑），记 STALE_INDEX_SUSPECT。判断口径是「提交后 5 秒内的剩余改动」，
只看本次提交的路径、不看别线文件；提交已经发生，本钩子只记录不阻断。

另对本次提交跑一次事后 hunk 残留检查（`scripts/check_commit_residue.py`，
约 0.35 s）：提交新增的行若以删除形态回到工作区未提交 diff，打印显眼块并追加
`.locks/residue_commits.log`（JSONL）。**只记录、不改退出码**——提交已落地，
卡下一笔只会把账算到别人头上。

最后把共享 index 同步到新 HEAD（`scripts/git_sync_index.py`）：私有
GIT_INDEX_FILE 提交后，共享 index 仍停在旧 HEAD，本次提交的每个文件都会
显示成「反向暂存」。同步失败只打印警告，不阻塞。

同步后再做一次**只读**的残余检查：剥掉调用方的 `GIT_INDEX_FILE`，跑
`git diff --cached --name-only` 看共享 index 还剩哪些暂存条目，非空就写
`INDEX_RESIDUE` 记录并逐条打印路径。**不改退出码、不阻断、不自动修复**——
这些条目可能是别线正在准备的提交，也可能是旧 blob 未重新 add（事故
`bc0c75e1`）；清理动作由 owner 或人工决定。

再做一道**提交后可构建烟雾检查**（`scripts/head_build_smoke.py`）：在该提交
自己的检出上跑一组既有的「能构造主窗口/面板」用例（实测约 5 s，文档类提交
跳过）。红 = 醒目打印 sha + 失败用例 + 首条错误 + 台账并追加
`head_build_smoke.log`；检查自身跑不起来（脚本缺失 / 超时 / 锁占满）同样记账
并打印，**不允许静默跳过**。这道闸补的是前面所有闸门都不判的一件事：
「提交出去的东西自身能不能构建」（事故 `12bcdb7a` 带走了调用侧、定义没跟上，
HEAD 有 272 s 构造主窗口直接 AttributeError）。本调用放在审计/绕过分支**之前**，
`MBDSDR_BYPASS_REASON` 的提交也照样跑；只记录，不改提交结果。
"""
import json
import os
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

MANAGED = "MBDSDR-MANAGED-HOOK post-commit"

#: 提交后自检窗口：超过这个窗口的改动可能只是别人随后又改，不能算漏带。
STALE_CHECK_WINDOW_S = 5.0

#: 提交后可构建烟雾检查的超时（含 Qt 全局锁等待）；超时按「无法判定」记账。
HEAD_BUILD_SMOKE_TIMEOUT_S = 240


def _git(*args):
    return subprocess.run(
        ["git", *args], capture_output=True, text=True, encoding="utf-8", errors="replace"
    )


def _claims_snapshot():
    """读取当时 claim 台账，返回 owner 与文件清单（含 active/remaining）。"""
    registry = (
        Path(os.environ.get("MBDSDR_LOCKS_DIR") or r"D:\mbdsdr\.locks") / "claims.json"
    )
    empty = {"registry": str(registry), "active_owners": [], "claims": []}
    try:
        data = json.loads(registry.read_text(encoding="utf-8"))
    except FileNotFoundError:
        empty["note"] = "台账不存在"
        return empty
    except (OSError, json.JSONDecodeError) as exc:
        empty["error"] = str(exc)
        return empty

    now = time.time()
    rows = []
    for key, entry in (data.get("claims") or {}).items():
        cur = entry.get("current")
        if not isinstance(cur, dict):
            continue
        try:
            heartbeat = float(cur.get("heartbeat_at") or cur.get("acquired_at") or 0)
            ttl_s = float(cur.get("ttl_min") or 0) * 60.0
        except (TypeError, ValueError):
            continue
        active = ttl_s > 0 and now - heartbeat <= ttl_s
        rows.append(
            {
                "path": cur.get("path") or key,
                "owner": str(cur.get("owner", "?")),
                "active": active,
                "remaining_min": round(max(0.0, (heartbeat + ttl_s - now) / 60.0), 1)
                if active
                else 0.0,
            }
        )
    return {
        "registry": str(registry),
        "active_owners": sorted({r["owner"] for r in rows if r["active"]}),
        "claims": rows,
    }


def _commit_files(head):
    return [
        line
        for line in _git("show", "--format=", "--name-only", "--no-renames", head)
        .stdout.splitlines()
        if line.strip()
    ]


def _norm(path):
    return os.path.normcase(str(path).replace("\\", "/")).lstrip("./")


def _declared_files():
    """`MBDSDR_COMMIT_PATHS`（换行 / `;` 分隔）声明的本次提交路径；未声明返回 None。"""
    raw = (os.environ.get("MBDSDR_COMMIT_PATHS") or "").strip()
    if not raw:
        return None
    items = [_norm(x.strip()) for x in raw.replace(";", "\n").splitlines() if x.strip()]
    return items or None


def _declared_mismatch(declared, actual):
    """声明的路径集合与实际提交路径集合的对称差；未声明返回 None。"""
    if declared is None:
        return None
    return sorted(set(declared) ^ {_norm(x) for x in actual})


def _hook_evidence(root, marker_dir):
    """返回「钩子侧故障」的可证实证据；空列表 = 不能断言 hook_error。"""
    evidence = []
    hooks_raw = _git("rev-parse", "--git-path", "hooks").stdout.strip()
    if not hooks_raw:
        evidence.append("无法定位 git hooks 目录")
    else:
        pre = Path(hooks_raw)
        if not pre.is_absolute():
            pre = root / pre
        pre = pre / "pre-commit"
        if not pre.exists():
            evidence.append("pre-commit 钩子不存在（闸门未安装或被删）")
        else:
            try:
                text = pre.read_text(encoding="utf-8", errors="replace")
            except OSError as exc:
                evidence.append(f"pre-commit 钩子不可读（{exc.__class__.__name__}）")
            else:
                if "MBDSDR-MANAGED-HOOK" not in text:
                    evidence.append("pre-commit 不是本仓管理的钩子（被替换或未安装）")
    try:
        marker_dir.mkdir(parents=True, exist_ok=True)
        probe = marker_dir / f".write_probe.{os.getpid()}"
        probe.write_text("", encoding="utf-8")
        probe.unlink()
    except OSError as exc:
        evidence.append(f"闸门标记目录不可写（{exc.__class__.__name__}）")
    return evidence


def _stale_index_suspects(head, files, started_at):
    """提交后自检：本次提交的路径若仍有工作区改动，说明提交用了旧索引。

    只看本次提交涉及的路径（不看别线文件），且只在提交后 5 秒窗口内判断：
    窗口外出现的改动可能只是别人随后又改了，不能算「这次漏带」。
    """
    records = []
    for path in files:
        if time.time() - started_at > STALE_CHECK_WINDOW_S:
            break
        status = _git("status", "--porcelain", "--", path).stdout.strip()
        if not status:
            continue
        diff = _git("diff", "HEAD", "--", path).stdout.splitlines()
        records.append(
            {
                "type": "STALE_INDEX_SUSPECT",
                "ts": datetime.now().isoformat(timespec="seconds"),
                "commit": head,
                "path": path,
                "status": status,
                "diff_lines": len(diff),
                "summary": diff[:10],
                "reason": (
                    "提交后工作区仍有改动：本次提交吃进的是旧索引内容"
                    "（漏带自己的编辑），不是别人随后又改"
                ),
            }
        )
    return records


def _append_records(log_path, records):
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a", encoding="utf-8") as fh:
        for rec in records:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")


def _sync_shared_index(root, files):
    """把共享 index 中「本次提交的路径」同步到新 HEAD。

    私有 GIT_INDEX_FILE 提交后，共享 index 仍停在旧 HEAD，本次提交的每个文件
    都会变成「反向暂存」（条目数 = 本次提交文件数）。只按这些路径精确改写
    （`update-index --cacheinfo`），别人的暂存条目一个不动——全量 read-tree
    会抹掉别线正在准备的提交意图。脚本缺失（如临时测试仓）静默跳过，
    失败只警告、不阻塞提交结果。
    """
    script = root / "scripts" / "git_sync_index.py"
    if not script.exists() or not files:
        return
    env = os.environ.copy()
    env.pop("GIT_INDEX_FILE", None)
    proc = subprocess.run(
        [sys.executable, str(script), "--paths", *files],
        cwd=str(root),
        env=env,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    out = (proc.stdout or "").strip().splitlines()
    err = (proc.stderr or "").strip().splitlines()
    if proc.returncode == 0:
        print(f"[post-commit] 共享 index 已同步（{out[-1] if out else 'ok'}）")
        return
    if proc.returncode == 2:
        print(
            "[post-commit] 本次提交路径已同步；共享 index 另有他人暂存条目（未动，"
            "按 §6.9.2 交由 owner 处理）",
            file=sys.stderr,
        )
        for line in err[:6]:
            if line.strip():
                print(f"    {line}", file=sys.stderr)
        return
    print(
        "[post-commit] 警告：共享 index 同步失败，下一笔提交前必须手工处理！",
        file=sys.stderr,
    )
    for line in (out + err)[:12]:
        if line.strip():
            print(f"    {line}", file=sys.stderr)


def _shared_index_residue(root):
    """共享 index 里残留的暂存条目；读不到时返回 None（不假报）。

    **只读**：不 `git add`、不 `restore`、不改退出码。剥掉调用方的
    ``GIT_INDEX_FILE``，看的是共享 index——私有 index 提交后，共享 index
    可能还挂着别人的暂存条目或旧 blob（事故 `bc0c75e1`）。
    """
    env = os.environ.copy()
    env.pop("GIT_INDEX_FILE", None)
    proc = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--no-renames"],
        cwd=str(root),
        env=env,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if proc.returncode != 0:
        return None
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


def _residue_records(root, head):
    """跑事后 hunk 残留检查（scripts/check_commit_residue.py --json）。

    返回记录列表；脚本不存在 / 退出码异常 / 输出不可解析时返回 None（不假报）。
    单次约 0.35 s（只读 git 对象与工作区 diff）。
    """
    script = root / "scripts" / "check_commit_residue.py"
    if not script.exists():
        return None
    proc = subprocess.run(
        [sys.executable, str(script), "--repo", str(root), "--json", head],
        cwd=str(root),
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if proc.returncode not in (0, 1):
        return None
    try:
        payload = json.loads(proc.stdout)
    except (json.JSONDecodeError, TypeError):
        return None
    records = []
    for item in payload.get("commits") or []:
        for rec in item.get("records") or []:
            records.append(rec)
    return records


def _report_residue(records):
    """打印显眼块 + 追加 JSONL 台账。**只记录，不阻断**：提交已经落地。

    残留常是别人未提交的 hunk 被整文件提交顺带抹掉；此时阻止下一笔只会把
    账算到错的人头上。可见 + 台账足够。
    """
    log_path = Path(
        os.environ.get("MBDSDR_RESIDUE_LOG") or r"D:\mbdsdr\.locks\residue_commits.log"
    )
    bar = "=" * 68
    print(f"[post-commit] {bar}")
    print(
        "[post-commit] ⚠ RESIDUE：本次提交新增的行，以删除形态回到工作区未提交"
        f" diff（{len(records)} 处）"
    )
    for rec in records:
        print(
            "[post-commit]   %s  %s:%d 起删 %d 行"
            % (
                str(rec.get("commit", ""))[:8],
                rec.get("path", "?"),
                int(rec.get("worktree_line") or 0),
                int(rec.get("matched_lines") or 0),
            )
        )
        for line in (rec.get("sample") or [])[:3]:
            print(f"[post-commit]     - {line}")
    print(f"[post-commit] 台账：{log_path}（只记录，不阻断提交结果）")
    print(f"[post-commit] {bar}")
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as fh:
            for rec in records:
                fh.write(
                    json.dumps(
                        {
                            "ts": datetime.now().isoformat(timespec="seconds"),
                            "type": "COMMIT_RESIDUE",
                            "commit": rec.get("commit"),
                            "path": rec.get("path"),
                            "worktree_line": rec.get("worktree_line"),
                            "matched_lines": rec.get("matched_lines"),
                            "sample": rec.get("sample"),
                        },
                        ensure_ascii=False,
                    )
                    + "\n"
                )
    except OSError as exc:
        print(f"[post-commit] 残留台账写入失败：{exc}", file=sys.stderr)


def _smoke_ledger_path():
    return Path(
        os.environ.get("MBDSDR_HEAD_BUILD_LOG")
        or r"D:\mbdsdr\.locks\head_build_smoke.log"
    )


def _smoke_script(root):
    """优先用本工作树的 scripts/head_build_smoke.py，其次 hooks 目录里的安装副本。

    旧工作树（HEAD 还没更新到本提交）没有 scripts/head_build_smoke.py，靠安装
    副本兜住；两处都没有才是「检查没跑成」。
    """
    candidates = [root / "scripts" / "head_build_smoke.py"]
    hooks_raw = _git("rev-parse", "--git-path", "hooks").stdout.strip()
    if hooks_raw:
        hooks = Path(hooks_raw)
        if not hooks.is_absolute():
            hooks = root / hooks
        candidates.append(hooks / "head_build_smoke.py")
    return next((path for path in candidates if path.exists()), None)


def _record_smoke_failure(head, reason, detail=""):
    """烟雾检查自身跑不起来：醒目打印 + 记 error，**不静默跳过**。"""
    log_path = _smoke_ledger_path()
    bar = "=" * 70
    print(f"[post-commit] {bar}", file=sys.stderr)
    print(f"[post-commit] ⚠ HEAD 可构建烟雾检查没跑成：{head[:8]}", file=sys.stderr)
    print(f"[post-commit]   原因：{reason}", file=sys.stderr)
    for line in (detail or "").strip().splitlines()[-6:]:
        print(f"[post-commit]     {line}", file=sys.stderr)
    print(f"[post-commit]   台账：{log_path}", file=sys.stderr)
    print(f"[post-commit] {bar}", file=sys.stderr)
    try:
        _append_records(
            log_path,
            [
                {
                    "ts": datetime.now().isoformat(timespec="seconds"),
                    "type": "HEAD_BUILD_SMOKE",
                    "status": "error",
                    "commit": head,
                    "reason": f"post-commit 侧：{reason}",
                    "failures": [],
                    "ledger": str(log_path),
                }
            ],
        )
    except OSError as exc:
        print(f"[post-commit] 烟雾台账写入失败：{exc}", file=sys.stderr)


def _head_build_smoke(root, head):
    """提交后可构建烟雾检查：红/跑不成都要可见，但**只记录、不改提交结果**。

    判的是「提交出去的东西自身能不能构建」，前面几道闸门都不判这件事。
    """
    script = _smoke_script(root)
    if script is None:
        _record_smoke_failure(
            head, "找不到 scripts/head_build_smoke.py（工作树与 hooks 目录都没有）"
        )
        return
    env = os.environ.copy()
    for key in ("GIT_INDEX_FILE", "GIT_DIR", "GIT_WORK_TREE", "GIT_PREFIX"):
        env.pop(key, None)
    try:
        proc = subprocess.run(
            [sys.executable, str(script), "--repo", str(root), "--commit", head],
            cwd=str(root),
            env=env,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=HEAD_BUILD_SMOKE_TIMEOUT_S,
        )
    except subprocess.TimeoutExpired:
        _record_smoke_failure(head, f"超出 {HEAD_BUILD_SMOKE_TIMEOUT_S}s 未返回")
        return
    except OSError as exc:
        _record_smoke_failure(
            head, f"无法启动烟雾检查：{exc.__class__.__name__}: {exc}"
        )
        return
    output = ((proc.stdout or "") + (proc.stderr or "")).strip()
    if output:
        print(output, file=sys.stderr)
    if proc.returncode not in (0, 3, 4):
        _record_smoke_failure(
            head, f"烟雾脚本自身异常退出 rc={proc.returncode}", output[-600:]
        )


def main():
    started_at = time.time()
    root = Path(_git("rev-parse", "--show-toplevel").stdout.strip() or ".")
    head = _git("rev-parse", "HEAD").stdout.strip()
    tree = _git("rev-parse", "HEAD^{tree}").stdout.strip()
    if not head or not tree:
        return 0

    files = _commit_files(head)
    _sync_shared_index(root, files)
    log_path = Path(
        os.environ.get("MBDSDR_HOOK_LOG") or r"D:\mbdsdr\.locks\git_hook_bypass.log"
    )

    # 共享 index 残余：只记录 + 打印路径，不改退出码、不阻断、不自动修。
    residue = _shared_index_residue(root)
    if residue:
        _append_records(
            log_path,
            [
                {
                    "type": "INDEX_RESIDUE",
                    "ts": datetime.now().isoformat(timespec="seconds"),
                    "commit": head,
                    "count": len(residue),
                    "paths": residue,
                    "reason": (
                        "提交后共享 index 仍有暂存条目：可能是别线正在准备提交，"
                        "也可能是旧 blob 未重新 add（事故 bc0c75e1）；只记录不修复"
                    ),
                }
            ],
        )
        print(
            f"[post-commit] 共享 index 残留 {len(residue)} 个暂存条目"
            "（只记录，不修复）：",
            file=sys.stderr,
        )
        for path in residue:
            print(f"    {path}", file=sys.stderr)

    # 提交后自检：旧索引漏带只记录、不阻断（提交已经发生，回滚不是本钩子的事）。
    stale = _stale_index_suspects(head, files, started_at)
    if stale:
        _append_records(log_path, stale)
        for rec in stale:
            print(
                f"[post-commit] 警告：{rec['path']} 提交后仍有未提交改动"
                f"（STALE_INDEX_SUSPECT，剩余 diff {rec['diff_lines']} 行）",
                file=sys.stderr,
            )

    # 提交后 hunk 残留（形态⑭的机械判据）：只打印 + 记账，不改退出码。
    try:
        residue = _residue_records(root, head)
    except Exception as exc:  # noqa: BLE001 —— 自检异常不许影响提交结果
        print(f"[post-commit] 残留检查异常（忽略）：{exc}", file=sys.stderr)
        residue = None
    if residue:
        _report_residue(residue)

    # 提交后可构建烟雾检查：判「提交出去的东西自身能不能构建」。
    # 放在审计/绕过分支之前——带 MBDSDR_BYPASS_REASON 的提交也照样跑。
    try:
        _head_build_smoke(root, head)
    except Exception as exc:  # noqa: BLE001 —— 自检异常不许影响提交结果，但要可见
        _record_smoke_failure(head, f"烟雾检查异常：{exc.__class__.__name__}: {exc}")

    marker_dir = Path(
        os.environ.get("MBDSDR_HOOK_MARKER_DIR") or r"D:\mbdsdr\.locks\hook_ok"
    )
    marker = marker_dir / f"{tree}.json"
    if marker.exists() and (time.time() - marker.stat().st_mtime) <= 900:
        # 空标记（files=[]）或损坏标记不算「已审计」：它可能来自一次无暂存内容的
        # pre-commit 运行，且以 tree 命名会覆盖同名 tree 的正常标记。
        valid = False
        try:
            payload = json.loads(marker.read_text(encoding="utf-8"))
            listed = payload.get("files")
            valid = isinstance(listed, list) and len(listed) > 0
        except (OSError, json.JSONDecodeError, AttributeError):
            valid = False
        if valid:
            try:
                marker.unlink()
            except OSError as exc:
                print(f"[post-commit] 清理闸门标记失败：{exc}", file=sys.stderr)
            return 0
        try:
            marker.unlink()
        except OSError:
            pass
        print(
            f"[post-commit] 忽略无效闸门标记 {marker.name}（files 为空或损坏），"
            "按未审计处理。",
            file=sys.stderr,
        )

    author = _git("log", "-1", "--format=%an <%ae>", head).stdout.strip()
    subject = _git("log", "-1", "--format=%s", head).stdout.strip()
    unaudited_log = Path(
        os.environ.get("MBDSDR_UNAUDITED_LOG") or r"D:\mbdsdr\.locks\unaudited_commits.log"
    )
    base = {
        "ts": datetime.now().isoformat(timespec="seconds"),
        "commit": head,
        "tree": tree,
        "author": author,
        "subject": subject,
        "files": files,
    }
    reason = (os.environ.get("MBDSDR_BYPASS_REASON") or "").strip()
    declared = _declared_files()

    if reason:
        # 主动绕过：必须自报事由（事由/文件/预期 owner），否则归入未审计。
        record = dict(
            base,
            type="HOOK_BYPASS",
            bypass_kind="explicit",
            reason=reason,
            declared_files=declared,
            declared_files_mismatch=_declared_mismatch(declared, files),
            declared_index=os.environ.get("MBDSDR_DECLARED_INDEX") or None,
            claims_snapshot=_claims_snapshot(),
        )
        _append_records(log_path, [record])
        print(
            f"[post-commit] 记录主动绕过（explicit）：{head[:8]} → {log_path}",
            file=sys.stderr,
        )
        return 0

    evidence = _hook_evidence(root, marker_dir)
    if evidence:
        record = dict(
            base,
            type="HOOK_BYPASS",
            bypass_kind="hook_error",
            reason="无 pre-commit marker，且钩子侧有故障证据：" + "；".join(evidence),
            hook_evidence=evidence,
            claims_snapshot=_claims_snapshot(),
        )
        _append_records(log_path, [record])
        print(
            f"[post-commit] 警告：钩子故障（hook_error）：{head[:8]} → {log_path}",
            file=sys.stderr,
        )
        return 0

    record = dict(
        base,
        type="UNAUDITED_COMMIT",
        bypass_kind="unattributed",
        audited=False,
        reason=(
            "无 pre-commit marker，且未声明 MBDSDR_BYPASS_REASON：无法区分静默绕过与"
            "钩子故障，记为未审计。主动绕过必须带 MBDSDR_BYPASS_REASON（含事由、"
            "要提交的文件、预期 owner）。"
        ),
        hook_evidence=[],
        claims_snapshot=_claims_snapshot(),
    )
    _append_records(unaudited_log, [record])
    print(
        f"[post-commit] 警告：{head[:8]} 未经审计（无 bypass 声明），已记录到 {unaudited_log}",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
